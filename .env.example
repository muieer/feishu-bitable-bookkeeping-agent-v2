# 默认读取项目根目录的 env.txt；也可通过 --env-file 选择此格式的配置文件。
LARK_APP_ID=cli_example
LARK_APP_SECRET=replace_me
ARK_API_KEY=replace_me
ARK_MODEL=your_ark_model_or_endpoint_id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_REASONING_EFFORT=low
MODEL_OUTPUT_TOKEN_LIMIT=16384
BITABLE_BASE_TOKEN=replace_me
BITABLE_TABLE_ID=tbl_example
BITABLE_DATE_FIELD=记账日期
BITABLE_AMOUNT_FIELD=金额
BITABLE_DESCRIPTION_FIELD=具体
LARK_CLI_PATH=lark-cli
LARK_CLI_IDENTITY=user
TIMEZONE=Asia/Shanghai
# 可选：逗号分隔的使用者 open_id。留空时按飞书应用可见范围接收用户消息。
ALLOWED_USER_IDS=
# 默认只接收私聊；如需群聊，将其改为 true，并在群里 @机器人。
ALLOW_GROUPS=false
MODEL_REQUEST_LIMIT=12
MODEL_TIMEOUT_SECONDS=90
TASK_TIMEOUT_SECONDS=300
CLI_TIMEOUT_SECONDS=30
RUNTIME_DIR=.runtime
